    </main>
  </div>

  <dialog class="adm-dialog" id="admConfirm" aria-labelledby="admConfirmTitle">
    <form method="dialog">
      <h2 id="admConfirmTitle">Are you sure?</h2>
      <p id="admConfirmText"></p>
      <div class="adm-actions">
        <button class="adm-btn adm-btn--ghost" value="cancel" autofocus>Cancel</button>
        <button class="adm-btn adm-btn--danger" value="confirm">Delete</button>
      </div>
    </form>
  </dialog>

  <script src="/js/admin.js"></script>
</body>
</html>
