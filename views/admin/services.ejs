<%- include('partials/top') %>
<header class="adm-head">
  <div>
    <p class="adm-eyebrow">Page</p>
    <h1>Services</h1>
    <p class="adm-muted">Visible services are listed above the hero headline (e.g. “Film · Photography · Direction”).</p>
  </div>
</header>

<section class="adm-card">
  <ol class="adm-sortable" data-reorder-url="/admin/services/reorder" aria-label="Services">
    <% services.forEach(function(service) { %>
      <li class="adm-row" data-id="<%= service._id %>">
        <button class="adm-handle" type="button" aria-label="Move <%= service.name %> (use arrow keys)">⋮⋮</button>
        <form method="post" action="/admin/services/<%= service._id %>" class="adm-row-main adm-form adm-form--row">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="adm-field">
            <label for="name-<%= service._id %>">Name</label>
            <input id="name-<%= service._id %>" name="name" type="text" value="<%= service.name %>" maxlength="60" required>
          </div>
          <div class="adm-field adm-grow">
            <label for="desc-<%= service._id %>">Description (optional)</label>
            <input id="desc-<%= service._id %>" name="description" type="text" value="<%= service.description %>" maxlength="500">
          </div>
          <button class="adm-btn adm-btn--small" type="submit">Save</button>
        </form>
        <%- include('partials/row-actions', {
          base: '/admin/services', item: service,
          toggles: [{ field: 'visible', on: 'Visible', off: 'Hidden' }],
          editHref: null, deleteLabel: service.name
        }) %>
      </li>
    <% }); %>
  </ol>
  <p class="adm-hint" data-reorder-status role="status"></p>

  <h3 class="adm-subhead">Add a service</h3>
  <form method="post" action="/admin/services" class="adm-form adm-form--row">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="adm-field">
      <label for="newName">Name <span class="adm-req" aria-hidden="true">*</span></label>
      <input id="newName" name="name" type="text" maxlength="60" required>
    </div>
    <div class="adm-field adm-grow">
      <label for="newDesc">Description</label>
      <input id="newDesc" name="description" type="text" maxlength="500">
    </div>
    <button class="adm-btn adm-btn--primary" type="submit">Add</button>
  </form>
</section>
<%- include('partials/bottom') %>
