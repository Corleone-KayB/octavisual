<%- include('../partials/top') %>
<header class="adm-head">
  <div>
    <p class="adm-eyebrow"><a href="/admin/photography">Photography</a></p>
    <h1>Edit photo</h1>
  </div>
</header>

<%- include('../partials/errors') %>

<form method="post" action="/admin/photography/<%= item._id %>" enctype="multipart/form-data" class="adm-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="adm-grid-2 adm-grid-2--wide">
    <section class="adm-card">
      <div class="adm-field">
        <label for="title">Title <span class="adm-req" aria-hidden="true">*</span></label>
        <input id="title" name="title" type="text" value="<%= item.title %>" maxlength="140" required>
      </div>
      <div class="adm-field">
        <label for="alt">Alt text <span class="adm-req" aria-hidden="true">*</span></label>
        <input id="alt" name="alt" type="text" value="<%= item.alt %>" maxlength="300" required>
        <p class="adm-hint">Describe what is in the photo for people using screen readers.</p>
      </div>
      <div class="adm-field">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3" maxlength="2000"><%= item.description %></textarea>
      </div>
      <div class="adm-field">
        <label for="year">Year</label>
        <input id="year" name="year" type="text" inputmode="numeric" pattern="(19|20)[0-9]{2}" value="<%= item.year %>" maxlength="4">
      </div>
      <%- include('../partials/taxonomy', { categories: categories, selectedCategories: item.categories, mediaType: 'photography', tags: item.tags, allTags: allTags }) %>
    </section>

    <section class="adm-card">
      <img class="adm-preview" src="<%= preview %>" alt="<%= item.alt %>" data-file-preview-target="image">
      <% if (item.source === 'link' && item.sourceUrl) { %><p class="adm-small adm-muted adm-truncate">Imported from <%= item.sourceUrl %></p><% } %>
      <div class="adm-field">
        <label for="image">Replace image</label>
        <input id="image" name="image" type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-file-preview>
      </div>
      <label class="adm-check"><input type="checkbox" name="published" <% if (item.published) { %>checked<% } %>> <span>Published</span></label>
      <label class="adm-check"><input type="checkbox" name="featured" <% if (item.featured) { %>checked<% } %>> <span>Featured</span></label>
    </section>
  </div>

  <div class="adm-actions adm-actions--sticky">
    <button class="adm-btn adm-btn--primary" type="submit">Save photo</button>
    <a class="adm-btn adm-btn--ghost" href="/admin/photography">Cancel</a>
  </div>
</form>
<%- include('../partials/bottom') %>
