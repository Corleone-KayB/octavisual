<% const footer = settings.footer || {}; %>
<footer class="workspace-footer">
  <span>© <%= new Date().getFullYear() %> <%= footer.copyright %></span>
  <% if (footer.tagline) { %><span><%= footer.tagline %></span><% } %>
  <a href="#<%= sections.length ? sections[0].anchor : 'home' %>"><%= footer.backToTop || 'Back to top ↑' %></a>
</footer>
