<%
  const navIcons = {
    hero: '<svg viewBox="0 0 24 24"><path d="M3 10.8 12 3l9 7.8v9.7a.5.5 0 0 1-.5.5h-5.7a.8.8 0 0 1-.8-.8V15a2 2 0 0 0-4 0v5.2a.8.8 0 0 1-.8.8H3.5a.5.5 0 0 1-.5-.5z"/></svg>',
    about: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>',
    work: '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
    team: '<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9" r="2.4"/><path d="M15.8 14.3A4.8 4.8 0 0 1 21 19"/></svg>',
    contact: '<svg viewBox="0 0 24 24"><path d="m4 5 8 7 8-7"/><rect x="3" y="5" width="18" height="14" rx="2"/></svg>',
    text: '<svg viewBox="0 0 24 24"><path d="M5 5h14M5 10h14M5 15h9M5 20h6"/></svg>'
  };
  // The mobile dock uses lighter variants of two icons.
  const dockIcons = Object.assign({}, navIcons, {
    about: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.5"/></svg>',
    team: '<svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9" r="2.4"/></svg>'
  });
  const instagram = safeUrl(settings.socials && settings.socials.instagram);
%>
<aside class="studio-sidebar" aria-label="Primary navigation">
  <a class="sidebar-brand magnetic" href="#<%= sections.length ? sections[0].anchor : 'home' %>" aria-label="Octavisual home">
    <img src="/images/logo.png" alt="Octavisual">
  </a>

  <nav class="sidebar-nav">
    <% sections.forEach(function(section, index) { %>
      <a class="nav-item <%= index === 0 ? 'is-active' : '' %>" href="#<%= section.anchor %>" data-section="<%= section.anchor %>" aria-label="<%= section.navLabel %>">
        <span class="nav-icon" aria-hidden="true"><%- navIcons[section.type] || navIcons.text %></span>
        <span class="nav-label"><%= section.navLabel %></span>
      </a>
    <% }); %>
  </nav>

  <% if (instagram) { %>
    <div class="sidebar-foot">
      <a class="nav-item nav-item--external" href="<%= instagram %>" target="_blank" rel="noopener" aria-label="Instagram">
        <span class="nav-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="icon-fill"/></svg>
        </span>
        <span class="nav-label">Instagram ↗</span>
      </a>
    </div>
  <% } %>
</aside>

<nav class="mobile-dock" aria-label="Mobile navigation">
  <% sections.forEach(function(section, index) { %>
    <a href="#<%= section.anchor %>" data-section="<%= section.anchor %>" class="mobile-nav-item <%= index === 0 ? 'is-active' : '' %>" aria-label="<%= section.navLabel %>">
      <%- dockIcons[section.type] || dockIcons.text %>
    </a>
  <% }); %>
</nav>
