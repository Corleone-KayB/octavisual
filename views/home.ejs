<section id="contact" class="contact-section">
  <div class="about-heading">
    <h1>Contact Us</h1>
  </div>

  <div class="contact-grid">
    <form class="contact-form" action="/contact" method="POST">
      <div class="form-row">
        <input type="text" name="name" placeholder="Your Name" required>
        <input type="email" name="email" placeholder="Your Email" required>
      </div>
      <input type="text" name="subject" placeholder="Subject" required>
      <textarea name="message" rows="6" placeholder="Your Message" required></textarea>
      <button type="submit" class="btn-submit">Send Message</button>

      <% if (success) { %>
        <p class="form-status form-status--success">Thank you — your message has been sent.</p>
      <% } %>
      <% if (error) { %>
        <p class="form-status form-status--error">Something went wrong. Please try again.</p>
      <% } %>
    </form>

    <div class="contact-info">
      <div class="info-block">
        <span class="info-label">Phone</span>
        <a href="tel:+250700000000">+250 700 000 000</a>
        <a href="tel:+250780000000">+250 780 000 000</a>
      </div>

      <div class="info-block">
        <span class="info-label">Email</span>
        <a href="mailto:hello@octavisual.com">hello@octavisual.com</a>
      </div>

      <div class="info-block">
