<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <section class="hero">
    <div class="slider">
      <div class="slide active" style="background-image: url('/images/slide2.jpg');"></div>
      <div class="slide" style="background-image: url('/images/slide1.jpg');"></div>
      <div class="slide" style="background-image: url('/images/slide3.jpg');"></div>
      <div class="slide" style="background-image: url('/images/slide4.jpg');"></div>
      <div class="slide" style="background-image: url('/images/slide5.jpg');"></div>
    </div>

    <div class="hero-overlay"></div>

    <%- include('partials/header') %>

    <div class="slider-dots">
      <span class="dot active" data-index="0"></span>
      <span class="dot" data-index="1"></span>
      <span class="dot" data-index="2"></span>
      <span class="dot" data-index="3"></span>
      <span class="dot" data-index="4"></span>
    </div>
  </section>
  <section id="about" class="about-section">
   <div class="about-heading">
    <h1>About Us</h1>
   </div>
   <div class="about-grid">
      <div class="about-media">
        <img src="/images/about.jpeg" alt="Behind the scenes with Octavisual.">
      </div>    
    
      <div class="about-copy">
    <p>
      Octavisual is a video and photography studio built around a simple idea: every
      story deserves to be told with care. From quiet portraits to full-scale event
      coverage, we approach each project as a chance to notice something worth keeping —
      a gesture, a moment of light, a truth in someone's expression.
    </p>
    <p>
      Our work spans commercial films, documentary shorts, and editorial photography,
      but the process stays the same. We listen first, shoot with intention, and edit
      with restraint, letting the subject lead rather than the technique.
    </p>
    <p>
      Beyond the camera, we partner with organizations and causes doing meaningful work
      in our communities, using film and photography to help those stories reach further
      and land deeper.
    </p>
  </div>
</section>

  <section id="portfolio" class="portfolio-page">
  <div class="portfolio-heading">
    <h1>Our Work</h1>
    <div class="filter-dropdown">
      <button class="filter-toggle" id="filterToggle">All &#9662;</button>
      <ul class="filter-menu" id="filterMenu">
        <li data-filter="all">All</li>
        <li data-filter="video">Videos</li>
        <li data-filter="picture">Pictures</li>
      </ul>
    </div>
  </div>

  <div class="gallery-grid" id="galleryGrid">
    <% items.forEach(function(item) { %>
      <div class="gallery-item" data-type="<%= item.type %>">
        <img src="<%= item.thumb %>" alt="<%= item.title %>">

        <% if (item.type === 'video') { %>
          <a class="overlay overlay-video" href="<%= item.youtube %>" target="_blank" rel="noopener">
            <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="7,4 21,12 7,20"></polygon>
            </svg>
          </a>
        <% } else { %>
          <span class="overlay overlay-picture">
            <svg class="icon-zoom" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="10" cy="10" r="7"></circle>
              <line x1="21" y1="21" x2="15.5" y2="15.5"></line>
            </svg>
          </span>
        <% } %>

        <span class="caption"><%= item.title %></span>
      </div>
    <% }); %>
  </div>
</section>

