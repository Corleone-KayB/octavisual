# Copy to .env for local development. On Render, add these under
# Environment instead of committing a .env file.

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
# "production" on Render (enables secure cookies). Render sets PORT itself.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# ─────────────────────────────────────────
# Contact form (Nodemailer). For Gmail use an App Password.
# ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=your-inbox@example.com

# ─────────────────────────────────────────
# Database (MongoDB Atlas) — all site content lives here
# ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/octavisual?retryWrites=true&w=majority

# ─────────────────────────────────────────
# Media storage (Cloudinary) — all images live here
# Cloudinary dashboard → Settings → API Keys
# ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=octavisual

# ─────────────────────────────────────────
# Admin login — creates the admin account the first time the app starts.
# Changing these later does not change the account; run `npm run admin:reset`.
# Use a long, unique password (12+ characters).
# ─────────────────────────────────────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-long-unique-passphrase

# ─────────────────────────────────────────
# Sessions — long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production.
# ─────────────────────────────────────────
SESSION_SECRET=

# ─────────────────────────────────────────
# Upload limit per image, in MB
# ─────────────────────────────────────────
MAX_UPLOAD_MB=15
